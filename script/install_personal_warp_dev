#!/usr/bin/env bash
#
# Build the current checkout as a persistent personal WarpDev app.
#
# This intentionally uses Warp's existing dev channel:
#   app identity: dev.warp.Warp-Dev
#   app name:     WarpDev
#   data dir:     ~/.warp-dev
#
# The installed app can be replaced repeatedly while ~/.warp-dev and the dev
# channel state directories remain intact.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  ./script/install_personal_warp_dev [options]

Options:
  --copy-stable-data   One-time seed from Stable Warp into WarpDev data dirs.
                       Copies sessions/state plus lightweight config. Excludes
                       ~/.warp/worktrees unless --copy-worktrees is also set.
  --copy-worktrees     With --copy-stable-data, also copy ~/.warp/worktrees.
  --open               Open the installed app after copying it into place.
  --open-stable        Also reopen /Applications/Warp.app after install.
  --debug              Build a debug bundle instead of the default dev release profile.
  --dest PATH          Install location. Default: ~/Applications/Warp-Dev.app.
  --features LIST      Extra comma-separated Cargo features. Default: tab_groups.
  --skip-build         Reinstall the last built WarpDev.app without rebuilding.
  -h, --help           Show this help.

Examples:
  ./script/install_personal_warp_dev --copy-stable-data --open --open-stable
  ./script/install_personal_warp_dev --open
  ./script/install_personal_warp_dev --features tab_groups,my_other_feature --open
EOF
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

dest="$HOME/Applications/Warp-Dev.app"
features="${WARP_PERSONAL_FEATURES:-tab_groups}"
copy_stable_data=false
copy_worktrees=false
open_after=false
open_stable_after=false
debug=false
skip_build=false

while (($#)); do
  case "$1" in
    --copy-stable-data)
      copy_stable_data=true
      shift
      ;;
    --copy-worktrees)
      copy_worktrees=true
      shift
      ;;
    --open)
      open_after=true
      shift
      ;;
    --open-stable)
      open_stable_after=true
      shift
      ;;
    --debug)
      debug=true
      shift
      ;;
    --dest)
      if [[ -z "${2:-}" || "${2:0:1}" == "-" ]]; then
        echo "error: --dest requires a path" >&2
        exit 1
      fi
      dest="$2"
      shift 2
      ;;
    --features)
      if [[ -z "${2:-}" || "${2:0:1}" == "-" ]]; then
        echo "error: --features requires a comma-separated feature list" >&2
        exit 1
      fi
      features="$2"
      shift 2
      ;;
    --skip-build)
      skip_build=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

profile_dir="release-lto-debug_assertions"
bundle_args=(--channel dev --features "$features" --nouniversal --selfsign)
if [[ "$debug" == true ]]; then
  profile_dir="debug"
  bundle_args+=(--debug)
fi
if [[ "$skip_build" == true ]]; then
  bundle_args+=(--skip-build)
fi

built_app="$repo_root/target/$profile_dir/bundle/osx/WarpDev.app"
stable_data="$HOME/.warp"
dev_data="$HOME/.warp-dev"
app_support="$HOME/Library/Application Support"
stable_app_support="$app_support/dev.warp.Warp-Stable"
dev_app_support="$app_support/dev.warp.Warp-Dev"
group_support="$HOME/Library/Group Containers/2BBY89MBSN.dev.warp/Library/Application Support"
stable_group_support="$group_support/dev.warp.Warp-Stable"
dev_group_support="$group_support/dev.warp.Warp-Dev"
timestamp="$(date +%Y%m%d-%H%M%S)"

quit_app() {
  local bundle_id="$1"
  osascript -e "tell application id \"$bundle_id\" to quit" >/dev/null 2>&1 || true
}

backup_if_exists() {
  local path="$1"
  if [[ -e "$path" || -L "$path" ]]; then
    local backup="$path.backup.$timestamp"
    echo "Backing up $path to $backup"
    mv "$path" "$backup"
  fi
}

copy_tree() {
  local source="$1"
  local dest="$2"
  shift 2

  if [[ ! -d "$source" ]]; then
    echo "Skipping missing source: $source"
    return
  fi

  mkdir -p "$dest"
  rsync -a --delete "$@" "$source"/ "$dest"/
}

if [[ "$copy_stable_data" == true ]]; then
  echo "Quitting Warp and WarpDev before copying data."
  quit_app "dev.warp.Warp-Stable"
  quit_app "dev.warp.Warp-Dev"
  sleep 1

  if [[ ! -d "$stable_data" ]]; then
    echo "error: cannot copy stable data because $stable_data does not exist" >&2
    exit 1
  fi

  backup_if_exists "$dev_data"
  backup_if_exists "$dev_group_support"
  backup_if_exists "$dev_app_support"

  portable_excludes=()
  if [[ "$copy_worktrees" != true ]]; then
    portable_excludes+=(--exclude worktrees)
  fi

  echo "Copying portable config $stable_data to $dev_data"
  copy_tree "$stable_data" "$dev_data" "${portable_excludes[@]}"

  echo "Copying secure state $stable_group_support to $dev_group_support"
  copy_tree "$stable_group_support" "$dev_group_support"

  echo "Copying app support state $stable_app_support to $dev_app_support"
  copy_tree "$stable_app_support" "$dev_app_support"
else
  quit_app "dev.warp.Warp-Dev"
fi

if [[ "$skip_build" != true ]]; then
  if ! command -v warp-channel-config >/dev/null 2>&1; then
    echo "error: warp-channel-config is required for bundled internal-channel builds." >&2
    echo "Run ./script/install_channel_config, then retry." >&2
    exit 1
  fi
fi

echo "Bundling WarpDev with features: $features"
./script/bundle "${bundle_args[@]}"

if [[ ! -d "$built_app" ]]; then
  echo "error: expected built app at $built_app" >&2
  exit 1
fi

mkdir -p "$(dirname "$dest")"
tmp_dest="$dest.tmp.$timestamp"
rm -rf "$tmp_dest"

echo "Installing $built_app to $dest"
ditto "$built_app" "$tmp_dest"
rm -rf "$dest"
mv "$tmp_dest" "$dest"
xattr -dr com.apple.quarantine "$dest" >/dev/null 2>&1 || true

echo "Installed personal WarpDev app: $dest"
echo "Persistent data directory: $dev_data"

if [[ "$open_after" == true ]]; then
  open "$dest"
fi

if [[ "$open_stable_after" == true ]]; then
  open "/Applications/Warp.app"
fi
